### Router1


enable
configure terminal
hostname Router1

interface gigabitEthernet 0/0/0
ip address 192.168.1.254 255.255.255.0
no shutdown
exit

interface loopback 0
ip address 192.168.100.254 255.255.255.255
exit

end
copy running-config startup-config


